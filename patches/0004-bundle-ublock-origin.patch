+    /**
+     * Installs the bundled content blocker (uBlock Origin, GPLv3) shipped in the APK assets.
+     * Installing an already-installed built-in extension is a no-op/update in GeckoView.
+     */
+    private fun installBundledContentBlocker() {
+        components.core.engine.installBuiltInWebExtension(
+            id = "uBlock0@raymondhill.net",
+            url = "resource://android/assets/extensions/ublock_origin.xpi",
+            onError = { throwable ->
+                logger.error("Failed to install bundled content blocker", throwable)
+            },
+        )
+    }
