# Pinned upstream Firefox release. Bump this every Firefox release (every ~4 weeks),
# then run scripts/prebuild.sh and fix any patch that no longer applies.
FIREFOX_TAG=FIREFOX_158_0_1_RELEASE
FIREFOX_REPO=https://github.com/mozilla-firefox/firefox.git

# Bundled content blocker (uBlock Origin, GPLv3). Pinned for reproducible builds.
UBO_VERSION=1.75.0

# App identity. Play listing title is set in Play Console: "Ad Blocker & Private Browser".
# APP_NAME is the label under the launcher icon (two words wrap onto two lines on most launchers).
APP_NAME="Ad Blocker Browser"
# Resulting package: com.nexcraft.browser (set in patches/0002-app-id.patch)

# Build target. arm64 covers almost all current Android phones.
TARGET=aarch64-linux-android
